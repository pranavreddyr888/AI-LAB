# A* using misplaced tiles
import heapq

# 0 represents the blank tile
initial_state = (2, 8, 3,
                 1, 6, 4,
                 7, 0, 5)

goal_state = (1, 2, 3,
              8, 0, 4,
              7, 6, 5)


def misplaced_tiles(state, goal):
    count = 0

    for i in range(9):
        if state[i] != 0 and state[i] != goal[i]:
            count += 1

    return count


def get_neighbors(state):
    neighbors = []
    blank = state.index(0)
    row, col = divmod(blank, 3)

    # Up, Down, Left, Right
    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_blank = new_row * 3 + new_col
            new_state = list(state)

            new_state[blank], new_state[new_blank] = (
                new_state[new_blank], new_state[blank]
            )

            neighbors.append(tuple(new_state))

    return neighbors


def a_star(initial, goal):
    # Priority queue: (f, g, state)
    pq = [(misplaced_tiles(initial, goal), 0, initial)]

    parent = {initial: None}
    cost = {initial: 0}
    explored = 0

    while pq:
        f, g, current = heapq.heappop(pq)

        # Ignore outdated queue entries
        if g != cost[current]:
            continue

        explored += 1

        if current == goal:
            path = []
            while current is not None:
                path.append(current)
                current = parent[current]

            path.reverse()
            return path, explored

        for neighbor in get_neighbors(current):
            new_g = g + 1

            if neighbor not in cost or new_g < cost[neighbor]:
                cost[neighbor] = new_g
                parent[neighbor] = current

                h = misplaced_tiles(neighbor, goal)
                new_f = new_g + h

                heapq.heappush(
                    pq, (new_f, new_g, neighbor)
                )

    return None, explored


def display_state(state):
    for i in range(0, 9, 3):
        print(*[x if x != 0 else "_" for x in state[i:i+3]])
    print()


path, explored = a_star(initial_state, goal_state)

print("A* SEARCH - MISPLACED TILES")
print("Initial State:")
display_state(initial_state)

if path:
    print("Solution Path:\n")

    for step, state in enumerate(path):
        print("Step:", step)
        display_state(state)

    print("Total moves:", len(path) - 1)
    print("States explored:", explored)
else:
    print("No solution found.")


#A* using manhattan distance


def manhattan_distance(state, goal):
    distance = 0

    for i in range(9):
        tile = state[i]

        if tile != 0:
            current_row, current_col = divmod(i, 3)
            goal_index = goal.index(tile)
            goal_row, goal_col = divmod(goal_index, 3)

            distance += (
                abs(current_row - goal_row)
                + abs(current_col - goal_col)
            )

    return distance
